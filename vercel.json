{
  "version": 2,
  "name": "tuna-ai-medical-assistant",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/v1/payments/create-order",
      "dest": "/api/create-order.js"
    },
    {
      "src": "/api/v1/interpret-lab",
      "dest": "/api/interpret-lab.js"
    },
    {
      "src": "/api/v1/query",
      "dest": "/api/query.js"
    },
    {
      "src": "/api/v1/webhook/pesapal",
      "dest": "/api/pesapal-ipn.js"
    },
    {
      "src": "/api/pesapal-ipn",
      "dest": "/api/pesapal-ipn.js"
    },
    {
      "src": "/api/create-order",
      "dest": "/api/create-order.js"
    },
    {
      "src": "/api/interpret-lab",
      "dest": "/api/interpret-lab.js"
    },
    {
      "src": "/api/query",
      "dest": "/api/query.js"
    },
    {
      "src": "/api/admin-stats",
      "dest": "/api/admin-stats.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "src": "/admin",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
